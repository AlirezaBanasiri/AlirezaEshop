<!DOCTYPE html><html lang="en"><head>    <meta charset="utf-8" />    <meta name="viewport" content="width=device-width, initial-scale=1.0" />    <title>@ViewData["Title"]فروشگاه</title>    <link rel="stylesheet" href="~/lib/bootstrap4/css/bootstrap-rtl.min.css" /></head><body class="rtl" style="font-family: Sahel,sans-serif;">    <header>        <nav class="navbar-expand-lg navbar navbar-dark bg-primary" >            <a class="navbar-brand" href="#">فروشگاه</a>            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">                <span class="navbar-toggler-icon"></span>            </button>            <div class="collapse navbar-collapse" id="navbarSupportedContent">                <ul class="navbar-nav mr-auto">                    <li class="nav-item active">                        <a class="nav-link" asp-controller="Home" asp-action="Index">خانه <span class="sr-only">(current)</span></a>                    </li>                    <li class="nav-item active">                        <a class="nav-link" asp-controller="Home" asp-action="ContactUs">تماس با ما</a>                    </li>                    <partial name="_Group">                        @if (User.Identity.IsAuthenticated)                        {                            <li class="nav-item active">                                <a class="nav-link text-white">@User.Identity.Name خوش آمدید</a>                            </li>                            <li class="nav-item active">                                <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">خروج</a>                            </li>                        }                        else                        {                            <li class="nav-item active">                                <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Register">ثبت نام</a>                            </li>                            <li class="nav-item active">                                <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Login">ورود</a>                            </li>                            }
                            @if (User.FindFirst("IsAdmin")?.Value=="True")
                            {                            <li class="nav-item active">                                <a class="nav-link text-white" asp-page="/Admin/Index">پنل ادمین</a>                            </li>                           }                    </ul>                @* 				<form class="form-inline my-2 my-lg-0">					<input class="form-control mr-sm-2" type="search" placeholder="Search" aria-label="Search">					<button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>				</form> *@            </div>        </nav>    </header>    <div class="container">        <div class="row">            <div class="col-md-3">                @await Component.InvokeAsync("ProductGroupsComponent")            </div>            <div class="col-md-9">                @RenderBody()            </div>        </div>    </div>    <footer class="border-top footer text-muted">        <div class="container">            &copy; 2026 - AlirezaEShop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>        </div>    </footer>    <script src="~/lib/jquery/dist/jquery.min.js"></script>    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>    <script src="~/js/site.js" asp-append-version="true"></script>    @await RenderSectionAsync("Scripts", required: false)</body></html>