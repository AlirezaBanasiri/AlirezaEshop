@model DetailsViewModel
@{
	ViewData["Title"] = "درخواست کالا " + Model.product.Name;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

<div class="container py-5">
    <div class="row">
        <!-- Product Images -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <img src="@($"/images/{Model.product.ID + Model.product.PictureExtention}")" class="card-img-top" alt="Product Image">
            </div>
        </div>

        <!-- Product Details -->
        <div class="col-md-6">
            <h1 class="h1 mb-3 font-weight-bolder">@Model.product.Name</h1>
            <div class="mb-3">
                <span class="h4 me-2 font-weight-bold">@Model.product.item.price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR")) ریال</span>
     @*            <span class="text-muted text-decoration-line-through">$399.99</span>
                <span class="badge bg-danger ms-2">25% OFF</span> *@
            </div>

            <div class="mb-3">
                <div class="d-flex align-items-center">
                    <div class="text-warning me-2">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="text-muted">(128 reviews)</span>
                </div>
            </div>

            <p class="mb-4 justify-content-around">
              @Model.product.Description
            </p>

            <!-- Color Selection -->
            <div class="mb-4">
                <h6 class="mb-2 font-weight-bold">رنگ</h6>
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="color" id="silver" checked>
                    <label class="btn btn-outline-secondary" for="silver">طوسی</label>
                    <input type="radio" class="btn-check" name="color" id="gold">
                    <label class="btn btn-outline-secondary" for="gold">طلایی</label>
                    <input type="radio" class="btn-check" name="color" id="black">
                    <label class="btn btn-outline-secondary" for="black">مشکی</label>
                </div>
            </div>

            <!-- Quantity -->
            <div class="mb-4">
                <div class="d-flex align-items-center">
                    <label class="me-2">تعداد:</label>
                    <select class="form-select w-auto">
                        <option>1</option>
                        <option>2</option>
                        <option>3</option>
                        <option>4</option>
                        <option>5</option>
                    </select>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-grid gap-2">
                <button class="btn btn-primary" type="button">افزودن به سبد خرید</button>
                <button class="btn btn-outline-secondary" type="button">
                    <i class="far fa-heart me-2"></i>افزودن به علاقه مندی
                </button>
            </div>

            <!-- Additional Info -->
            <div class="mt-4">
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-truck text-primary me-2"></i>
                    <span> ارسال رایگان برای سفارش‌های بالای ۵۰ دلار </span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-undo text-primary me-2"></i>
                    <span> سیاست مرجوعی ۳۰ روزه </span>
                </div>
                <div class="d-flex align-items-center">
                    <i class="fas fa-shield-alt text-primary me-2"></i>
                    <span> گارانتی ۲ ساله </span>
                </div>
            </div>
        </div>
    </div>
</div>

