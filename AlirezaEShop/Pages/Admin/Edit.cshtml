@page
@model AlirezaEShop.Pages.Admin.EditModel
@{
}
<h1>ویرایش کالا</h1>
<hr />
<form method="post" enctype="multipart/form-data">

	<dl class="list-group-horizontal">
		<input type="hidden" asp-for="Product.ID"/>
		<dd>
			<label asp-for="Product.Name"></label>
		</dd>
		<dt>
			<input asp-for="Product.Name" class="form-control" />
			<span asp-validation-for="Product.Name"></span>
		</dt>
		<dd>
			<label asp-for="Product.Description"></label>
		</dd>
		<dt>
			<input asp-for="Product.Description" class="form-control" />
			<span asp-validation-for="Product.Description"></span>
		</dt>
		<dd>
			<label asp-for="Product.Price"></label>
		</dd>
		<dt>
			<input asp-for="Product.Price" class="form-control" />
			<span asp-validation-for="Product.Price"></span>
		</dt>
		<dd>
			<label asp-for="Product.QuantityInStock"></label>
		</dd>
		<dt>
			<input asp-for="Product.QuantityInStock" class="form-control" />
			<span asp-validation-for="Product.QuantityInStock"></span>
		</dt>
		<dd>
			<label asp-for="Product.Picture"></label>
		</dd>
		<dt>
			<input asp-for="Product.Picture" class="form-control" />
			<span asp-validation-for="Product.Picture"></span>
		</dt>
		<dd>
			گروه ها
		</dd>
		@foreach (var Item in Model.Product.Categories)	
		{
			<dt>
				<p>
					<input type="checkbox" name="SelectedGroups" value="@Item.ID"
					@((Model.ProducGroups.Any(c=>c==Item.ID)?"Checked":""))/>@Item.Name
				</p>
			</dt>
		}
		<dd></dd>
		<dt>
			<input type="submit" class="btn btn-success" value="ثبت" />
		</dt>
	</dl>

</form>

