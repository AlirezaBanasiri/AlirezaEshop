<!DOCTYPE html>

<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title</title>
	<link href="~/css/admin.css" rel="stylesheet" />
	<link rel="stylesheet" href="~/lib/bootstrap4/css/bootstrap-rtl.min.css" />
</head>
<body dir="rtl">
	<header>
		<a href="/">Admin</a>
	</header>
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-2">
				<nav>
					<ul>
						<li>
							<a class="nav-item">Home</a>
						</li>
					</ul>
				</nav>
			</div>

			<div class="col-md-10">
				@RenderBody()
			</div>
		</div>
	</div>
	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
